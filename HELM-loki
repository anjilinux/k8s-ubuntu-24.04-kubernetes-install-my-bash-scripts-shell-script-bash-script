===========================
helm uninstall loki -n monitoring
kubectl delete pvc -n monitoring --all

helm install loki grafana/loki -n monitoring -f loki-values.yaml
==================
deploymentMode: SingleBinary

singleBinary:
  replicas: 1

backend:
  replicas: 0

read:
  replicas: 0

write:
  replicas: 0

gateway:
  enabled: false

chunksCache:
  enabled: false

resultsCache:
  enabled: false

loki:
  auth_enabled: false

  commonConfig:
    replication_factor: 1

  storage:
    type: filesystem

  limits_config:
    allow_structured_metadata: false

  schemaConfig:
    configs:
      - from: "2024-01-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index:
          prefix: index_
          period: 24h

sidecar:
  rules:
    enabled: false

lokiCanary:
  enabled: true

persistence:
  enabled: true
  size: 10Gi
  storageClassName: local-path
