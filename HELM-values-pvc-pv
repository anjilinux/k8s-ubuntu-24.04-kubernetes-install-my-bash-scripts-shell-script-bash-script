grafana:
  service:
    type: NodePort
    nodePort: 30000

  persistence:
    enabled: true
    size: 5Gi

  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
        - name: Prometheus
          type: prometheus
          access: proxy
          url: http://monitoring-kube-prometheus-prometheus:9090
          isDefault: true

        - name: Loki
          type: loki
          access: proxy
          url: http://loki:3100


##################  otel-values.yaml  ##################################
mode: deployment

extraVolumes:
  - name: otel-storage
    persistentVolumeClaim:
      claimName: otel-pvc

extraVolumeMounts:
  - name: otel-storage
    mountPath: /data

config:
  receivers:
    otlp:
      protocols:
        grpc:
        http:

  exporters:
    file:
      path: /data/output.json

  service:
    pipelines:
      traces:
        receivers: [otlp]
        exporters: [file]
