
helm install otel open-telemetry/opentelemetry-collector \
  -n monitoring \
  -f otel-values.yaml
##################  otel-values.yaml  ##################################
mode: deployment

extraVolumes:
  - name: otel-storage
    persistentVolumeClaim:
      claimName: otel-pvc

extraVolumeMounts:
  - name: otel-storage
    mountPath: /data

config:
  receivers:
    otlp:
      protocols:
        grpc:
        http:

  exporters:
    jaeger:
      endpoint: jaeger.monitoring.svc.cluster.local:14250
      tls:
        insecure: true

  service:
    pipelines:
      traces:
        receivers: [otlp]
        exporters: [jaeger]
